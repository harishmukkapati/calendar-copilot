# Secrets generated by Terraform. The Gemini API key is NOT here: create it by hand
# (see infra/README.md) so it never appears in Terraform state.

resource "aws_ssm_parameter" "db_password" {
  name  = "${local.ssm_prefix}/db-password"
  type  = "SecureString"
  value = random_password.db.result
}

resource "aws_ssm_parameter" "origin_verify" {
  name  = "${local.ssm_prefix}/origin-verify"
  type  = "SecureString"
  value = random_password.origin_verify.result
}
